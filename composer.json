{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "devapps/laravel-modules-kit",
    "description": "Laravel module generator and runtime loader for API, Blade, or hybrid modules.",
    "type": "library",
    "version": "1.0.2",
    "license": "MIT",
    "keywords": [
        "laravel",
        "modules",
        "generator",
        "blade",
        "api"
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0",
        "illuminate/contracts": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/filesystem": "^10.0|^11.0",
        "illuminate/pagination": "^10.0|^11.0",
        "illuminate/support": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "DevApps\\LaravelModulesKit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DevApps\\LaravelModulesKit\\LaravelModulesKitServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
